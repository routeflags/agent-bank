# 本番用環境変数テンプレート（Lamprey / agent-bank）
#
# 使い方: このファイルを `.env` にコピーし、値を設定する。
#   cp .env.example .env
# `compose.production.yaml` はこの `.env` から読む。`.env` は git 管理しない。
#
# 注意:
# - ここには実際の秘密情報を書かない。キー名と説明のみ。
# - 既存の `.env` はリポジトリに存在しないため、キー名は
#   `docker-compose.dev.yml` とコード内の ENV 参照から洗い出した。
# - Rails の APP_CONFIG は未設定項目を ENV で上書きできる
#   （config/config_loader.rb）。一覧は config/config.defaults.yml を参照。
# - AI プロバイダーの API キーは DB 管理（ai_providers テーブル）のため ENV 不要。

# === Compose 基盤: MySQL ===
# MySQL コンテナの初期化と Rails の DATABASE_URL で同じ値を使うこと。
# root のパスワード（必須。推測困難な文字列を設定）
MYSQL_ROOT_PASSWORD=
# アプリ用 DB ユーザー（必須）
MYSQL_USER=
# アプリ用 DB パスワード（必須）
MYSQL_PASSWORD=
# アプリ用 DB 名（未設定時は sharetribe_production）
MYSQL_DATABASE=

# === Compose 基盤: Rails の DB/Redis 接続 ===
# Rails の DB 接続 URL（必須）。MYSQL_* と同じ認証情報で組み立てる。
# 形式: mysql2://<MYSQL_USER>:<MYSQL_PASSWORD>@mysql:3306/<MYSQL_DATABASE>
DATABASE_URL=
# Action Cable 等が使う Redis URL（未設定時は redis://redis:6379/0）
REDIS_URL=

# === Compose 基盤: Rails 実行 ===
# Rails 待受ポート（未設定時は 3000。compose は 127.0.0.1 のみ公開）
PORT=
# web 起動時の db:migrate 実行（未設定時は true。startup.sh の既定 false とは別層）
RUN_DB_MIGRATE=
# Delayed Job の処理キュー（未設定時は default,paperclip,mailers）
QUEUES=
# 本番で静的ファイルを Rails が配信する（未設定時は true。リバースプロキシ構成用）
RAILS_SERVE_STATIC_FILES=
# Puma スレッド数（未設定時は 5。config/puma.rb）
RAILS_MAX_THREADS=
# Rails credentials を使う場合のマスターキー（使わない場合は空のまま）
RAILS_MASTER_KEY=

# === Rails アプリ設定: ドメインと HTTPS ===
# 公開ドメイン（例: example.com。Caddy 等と一致させる）
domain=
# 常に HTTPS へリダイレクト（本番は true。/_health は除外される）
always_use_ssl=
# 署名付き Cookie の秘密鍵（必須。`bin/rails secret` で生成）
secret_key_base=
# Stripe キー暗号化用（必須。ランダム文字列）
app_encryption_key=

# === Rails アプリ設定: メール ===
# 送信元アドレス（必須。本番ドメインのもの）
sharetribe_mail_from_address=
# 配信方式: sendmail または smtp
mail_delivery_method=
# smtp 選択時のみ必要
smtp_email_address=
smtp_email_port=
smtp_email_user_name=
smtp_email_password=
smtp_email_domain=

# === Rails キャッシュ用 Redis（production.rb は小文字キーで読む） ===
# REDIS_URL（大文字）とは別物。キャッシュストアはこちらを使う。
# compose 内 Redis を指す場合は redis / 6379 / 0 を指定。
redis_host=
redis_port=
redis_db=
# キャッシュの名前空間（未設定時は cache）
redis_cache_namespace=
# キャッシュ有効期限（分。未設定時は 240）
redis_expires_in=

# === ファイル保存（S3 を使う場合のみ） ===
# 未設定時はローカル保存（public/system ボリューム）。S3 利用時は以下を設定。
active_storage_service=
s3_bucket_name=
aws_access_key_id=
aws_secret_access_key=
s3_region=
# CDN を使う場合（例: https://xxx.cloudfront.net）
user_asset_host=
asset_host=

# === 課金: Freemius（ウォレットチャージ利用時のみ） ===
# app/services/freemius_client.rb が読む。使わない場合は空のまま。
PRODUCT_SECRET_KEY=
FREEMIUS_WEBHOOK_SECRET=
PRODUCT_ID=
FREEMIUS_PRODUCT_ID=
API_BEARER_AUTHORIZATION_TOKEN=
FREEMIUS_API_KEY=
# 既定値あり（未設定時は既定の API ベース URL）
FREEMIUS_API_BASE_URL=
# 金額プランマップ（JSON。例: {"1000": 1000}）。未設定時は起動時チェックで検出。
FREEMIUS_TOPUP_PLAN_MAP=
# 円ドル換算レート・価格表・許容誤差（app/services/freemius_pricing.rb）
FREEMIUS_JPY_USD_RATE=
FREEMIUS_PLAN_PRICE_MAP=
FREEMIUS_PRICE_TOLERANCE_PCT=

# === プロセス調整 ===
# Passenger（未設定時は各 1。docker-compose.app.yml と同値）
PASSENGER_MIN_INSTANCES=
PASSENGER_MAX_POOL_SIZE=
# メンテナンス表示（true で nginx 保守画面。migrate はスキップされる）
MAINTENANCE_MODE=

# === リバースプロキシ: Caddy の公開ドメイン（Phase 4） ===
# Caddy のサイトアドレスに使う（例: APP_DOMAIN=example.com）。Rails の `domain` とは別物。
# 空または未設定のままなら compose が localhost に読み替え、Caddy は HTTP のみで待受ける
# （証明書の取得も HTTPS リダイレクトも行わない。Caddyfile の変更は不要）。
# ドメイン取得後にここへ FQDN を記入すれば、caddy の再起動時に自動で証明書を取得し、
# HTTP → HTTPS リダイレクトが有効になる。手順は documents/plans/20261028-vps-phase4.md。
APP_DOMAIN=
