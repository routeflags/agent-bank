-# ── Hero layout ────────────────────────────────────────
%script{type: "text/template", class: "template", id: "image-frame-template"}
  .listing-image-frame
    #listing-image-link.listing-image-frame-content
      .listing-image-vertical-centering{:class => "${aspectRatioClass}"}
        %img{:src => "${url}", :alt => @listing.title, :class => "listing-image ${aspectRatioClass}"}

%script{type: "text/template", class: "template", id: "image-thumbnail-template"}
  -# Issue #83: サムネイルは role=button 化（thumbnail_stripe.js）されているため
  -# 名前が必要。img に出品タイトルを載せるとボタンの accessible name になる。
  .listing-image-thumbnail-container
    %img.listing-image-thumbnail{src: "${url}", alt: @listing.title}
    .fade

.raku-listing-hero
  -# ── Left: Image + Description ──────────────────────────
  .raku-listing-hero__content
    - with_image_frame(@listing) do |reason, listing_images|
      - if reason == :images_ok
        .listing-image-carousel
          #listing-image-frame
          - if @listing_presenter.prev_image_id && @listing_presenter.next_image_id
            = link_to params.permit(:id, :locale).merge(image: @listing_presenter.prev_image_id), class: "listing-image-navi listing-image-navi-left", id: "listing-image-navi-left", aria: {label: t('lamprey.listings.prev_image')} do
              .listing-image-navi-arrow-container
                .listing-image-arrow-icon-container.left
                  = icon_tag("directleft", ["navigate-icon-fix", "listing-image-navi-arrow"])
            = link_to params.permit(:id, :locale).merge(image: @listing_presenter.next_image_id), class: "listing-image-navi listing-image-navi-right", id: "listing-image-navi-right", aria: {label: t('lamprey.listings.next_image')} do
              .listing-image-navi-arrow-container
                .listing-image-arrow-icon-container.right
                  = icon_tag("directright", ["navigate-icon-fix", "listing-image-navi-arrow"])
        #thumbnail-stripe.listing-image-thumbnail-stripe
        - content_for :extra_javascript do
          :javascript
            var listingImages = #{raw listing_images.map { |image| ListingImageJsAdapter.new(image) }.to_json }
            var currentImage = #{params[:image].present? ? params[:image].to_i : listing_images.first.id};
            ST.listingImages(listingImages, currentImage);
      - else
        .listing-image-text-container
          .listing-image-frame
            .listing-image-frame-content
              .listing-image-vertical-centering
                .listing-no-image
                  - if reason == :images_processing
                    = t("listings.show.processing_uploaded_image")
                  - else
                    .raku-listing-hero__image-placeholder{style: "display:flex; align-items:center; justify-content:center; font-size:64px; background:var(--bg-card); border-radius:var(--radius-lg); aspect-ratio:16/10; color:var(--text-muted);"} 🤖

    -# ── Tab panels ─────────────────────────────────────────
    -# 機能・特徴パネル
    .raku-tab-panel{id: "panel-features", role: "tabpanel", "aria-labelledby": "tab-features", "data-raku-panel" => "features"}
      - if @listing.custom_field_values.any?
        .raku-features
          - @listing.custom_field_values.each do |cfv|
            - cfv.with_type do |question_type|
              - if question_type == :text
                -# Issue #20: テキストフィールドは値を Markdown として表示する
                .raku-features__text
                  %span.raku-features__text-title= cfv.question&.name(I18n.locale)
                  .raku-features__text-body= markdown(cfv.text_value.to_s)
              - else
                .raku-features__item
                  %span.raku-features__check ✓
                  = cfv.question&.name || t('lamprey.listings.features_default')
      - else
        -# Issue #90: 機能はカテゴリのカスタムフィールド値で登録する（出品の新規・編集画面）。
        -# skill_markdown は AI への指示文のため表示しない。未登録時は出品者本人にだけ編集導線を出す。
        %p.raku-tab-panel__empty= t('lamprey.listings.no_features')
        - if logged_in? && @listing.author == @current_user
          = link_to t('listings.edit_links.edit_listing'), edit_listing_path(@listing), class: "raku-link-gold"

    -# 概要パネル（デフォルト表示）
    .raku-tab-panel.is-active{id: "panel-overview", role: "tabpanel", "aria-labelledby": "tab-overview", "data-raku-panel" => "overview"}
      .row
        .col-12.listing-description-content
          - if @listing.description && !@listing.description.blank?
            = markdown(@listing.description)
            - if @listing_presenter.youtube_link_ids.present?
              - @listing_presenter.youtube_link_ids.each do |youtube_id|
                .listing-description-youtube-wrapper
                  %iframe.listing-description-youtube-iframe{ title: t("listings.show.youtube_video_player"), width: 640, height:390, src: "//www.youtube-nocookie.com/embed/#{ youtube_id }", frameborder: 0, allowfullscreen: true}
          - else
            %p.raku-tab-panel__empty= t('lamprey.listings.no_description')

      - @listing.custom_field_values.each do |custom_field_value|
        .row
          .col-12
            - custom_field_value.with_type do |question_type|
              = render :partial => "listings/custom_field_partials/#{question_type}", :locals => { :custom_field_value => custom_field_value }

      - if @current_community.show_listing_publishing_date?
        .row
          .col-12
            .icon-with-text-container
              = icon_tag("calendar", ["icon-part"])
              .text-part
                %b
                  = t(".listing_created_at")
                  = l @listing.created_at, :format => :short_date

    -# 使い方パネル
    .raku-tab-panel{id: "panel-how_to_use", role: "tabpanel", "aria-labelledby": "tab-how_to_use", "data-raku-panel" => "how_to_use"}
      .raku-howto
        %h3.raku-howto__title= t('lamprey.listings.how_to_use')
        %ol.raku-howto__steps
          %li= t('lamprey.listings.how_to_step1')
          %li= t('lamprey.listings.how_to_step2')
          %li= t('lamprey.listings.how_to_step3')
          %li= t('lamprey.listings.how_to_step4')

    -# レビューパネル
    .raku-tab-panel{id: "panel-reviews", role: "tabpanel", "aria-labelledby": "tab-reviews", "data-raku-panel" => "reviews"}
      - unless (@listing.closed? && !current_user?(@listing.author)) || !@current_community.listing_comments_in_use
        .view-item
          #comments.discussion.overflow-allowed
            %h2
              = icon_tag("chat_bubble", ["icon-with_text"])
              .text-with-icon
                = t(".comments")
                %span#comment_count= "(#{@listing.comments_count})"
            #follow-links.follow-links
              = render :partial => "follow_links"
            #comment-list
              = render :partial => "comment", :collection => @listing.comments
            #comment-form
              = render :partial => "comment_form"
      - else
        %p.raku-tab-panel__empty= t('lamprey.listings.no_reviews')

    -# 関連ペルソナパネル
    .raku-tab-panel{id: "panel-related", role: "tabpanel", "aria-labelledby": "tab-related", "data-raku-panel" => "related"}
      - related = @listing_presenter.related_listings
      - if related.any?
        .raku-related
          - related.each do |rel|
            %a.raku-related__item{href: listing_path(rel)}
              %span.raku-related__icon 🤖
              %span.raku-related__title= rel.title
      - else
        %p.raku-tab-panel__empty= t('lamprey.listings.no_related')

  -# ── Right sidebar: Price + CTA + Seller ───────────────
  .raku-listing-hero__sidebar
    -# Price box（Issue #52: 全出品は有料。価格は必須）
    .raku-price-box
      - if @listing.price && @listing.price_cents.to_i.positive?
        .raku-price-box__amount
          = MoneyViewUtils.to_humanized(@listing.price)
        -# Issue #93: トークン課金に出品の時間・数量単位は無意味。レガシー形状の
        -# unit_type（例: :hour）が残っていると「/ 時間」と誤表示されるため、
        -# with_quantity_text（raku-price-box__unit）は描画しない。単価の意味は
        -# 下の price_note（100万トークンあたり）で示す。
      - else
        .raku-price-box__amount= t('lamprey.listings.price_unset')
        - if logged_in? && @listing.author == @current_user
          = link_to t('lamprey.listings.set_price'), edit_listing_path(@listing), class: "raku-cta-btn raku-cta-btn--ghost"
      .raku-price-box__note= t('lamprey.listings.price_note')
      -# Freemius は USD 建て請求のため、円価格の近くに USD 目安を示す（レート設定時のみ）
      - if @listing.price && @listing.price_cents.to_i.positive? && FreemiusPricing.configured?
        .raku-price-box__note= t('lamprey.listings.usd_billing_note', usd: FreemiusPricing.format_usd(FreemiusPricing.usd_cents_for_jpy(@listing.price_cents.to_i)), jpy: number_with_delimiter(@listing.price_cents.to_i))

      .raku-price-box__rating
        - if @listing.respond_to?(:average_rating) && @listing.average_rating.present?
          ★ #{@listing.average_rating.round(1)}
          %span.raku-price-box__rating-count= t('lamprey.listings.reviews_count', count: @listing.reviews_count || 0)
        - else
          %span.raku-muted-label= t('lamprey.listings.rating_none')

    -# CTA buttons
    - chat_enabled = @listing.default_run_mode.present? && @listing.default_run_mode == 'run_online'
    .raku-cta-group
      - if logged_in? && @listing.author == @current_user
        = link_to edit_listing_path(@listing), class: "raku-cta-btn raku-cta-btn--ghost" do
          = t('listings.edit_links.edit_listing')
      - if logged_in?
        - if chat_enabled
          %button.raku-cta-btn.raku-cta-btn--primary{type: "button", onclick: "window.LampreyChat && window.LampreyChat.open()"}
            = t('lamprey.listings.use_skill')
        - else
          = link_to initiate_order_path(listing_id: @listing.id), class: "raku-cta-btn raku-cta-btn--primary" do
            = t('lamprey.listings.use_skill')
      - else
        = link_to login_path, class: "raku-cta-btn raku-cta-btn--primary" do
          = t('lamprey.listings.login_to_use')
      - if @listing.author != @current_user && @current_community.allow_free_conversations?
        %a.raku-cta-btn.raku-cta-btn--ghost{href: contact_to_listing_path(:listing_id => @listing.id.to_s)}
          = t('lamprey.listings.contact_seller')

    -# Seller card
    .raku-seller-card
      .raku-seller-card__avatar
        = medium_avatar_thumb(@listing.author, {:class => "raku-seller-card__avatar"})
      %div
        .raku-seller-card__name
          = link_to PersonViewUtils.person_display_name(@listing.author, @current_community), person_path(username: @listing.author.username), :class => "listing-author-name-link", :id => "listing-author-link"

    -# Detail panel
    .raku-detail-panel
      .raku-detail-panel__title= t('lamprey.listings.skill_detail')
      .raku-detail-panel__grid
        .raku-detail-panel__item
          .raku-detail-panel__label= t('lamprey.listings.last_updated')
          .raku-detail-panel__value= l @listing.updated_at, :format => :short_date
        .raku-detail-panel__item
          .raku-detail-panel__label= t('lamprey.listings.published_date')
          .raku-detail-panel__value= l @listing.created_at, :format => :short_date

    -# ── Additional product data for informed purchase ───
    .raku-detail-panel
      .raku-detail-panel__title= t('lamprey.listings.pricing_model')
      .raku-detail-panel__grid
        .raku-detail-panel__item
          .raku-detail-panel__label= t('lamprey.listings.token_price')
          .raku-detail-panel__value
            - if @listing.price && @listing.price_cents.to_i.positive?
              = MoneyViewUtils.to_humanized(@listing.price)
            - else
              = t('lamprey.listings.price_unset')
        .raku-detail-panel__item
          .raku-detail-panel__label= t('lamprey.listings.free_trial')
          .raku-detail-panel__value
            - if @listing.respond_to?(:free_trial) && @listing.free_trial.present?
              = t('lamprey.listings.yes')
            - else
              = t('lamprey.listings.no')
        .raku-detail-panel__item
          .raku-detail-panel__label= t('lamprey.listings.privacy')
          .raku-detail-panel__value= t('lamprey.listings.privacy_value')
        .raku-detail-panel__item
          .raku-detail-panel__label= t('lamprey.listings.cancellation')
          .raku-detail-panel__value= t('lamprey.listings.cancellation_value')

    -# Seller activity
    - if @listing_presenter.received_testimonials.size > 0
      .raku-seller-card{style: "flex-direction: column; align-items: flex-start; gap: 8px; padding: 16px;"}
        .listing-author-activity-item
          .listing-author-activity-value
            = @listing_presenter.feedback_positive_percentage.to_s + "%"
            = t("people.show.positive")
            = "(#{@listing_presenter.received_positive_testimonials.size}/#{@listing_presenter.received_testimonials.size})"
          .listing-author-activity-description
            = t(".feedback")

/ AI Persona Chat Panel — mounts only when the listing has an active persona
- if @listing.default_run_mode.present? && @listing.default_run_mode == 'run_online'
  -# Strip whitespace-only lines from the react-rails output: HAML indents
  -# multiline helper output, which otherwise emits trailing-whitespace lines.
  -# ヘッダーは販売者名ではなく出品タイトルを出す（Issue #67）。
  -# 販売者名は短く識別性が低いため、どのペルソナと会話しているかを
  -# タイトルで示す。タイトルが空のときだけフォールバックする。
  = raw(react_component("ChatPanelApp", props: { listing_id: @listing.id, persona_name: @listing.title.presence || 'AI Assistant', i18n: chat_panel_i18n }, prerender: false).to_s.gsub(/^[ \t]+\n/, ""))
