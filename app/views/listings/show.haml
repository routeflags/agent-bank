- content_for :extra_javascript do
  :javascript
    // 楽市楽問 — listing detail tab switching
    window.RakuTabs = {
      show: function (name) {
        var panels = document.querySelectorAll('.raku-tab-panel');
        for (var i = 0; i < panels.length; i++) {
          var on = panels[i].getAttribute('data-raku-panel') === name;
          if (on) { panels[i].classList.add('is-active'); }
          else { panels[i].classList.remove('is-active'); }
        }
        var tabs = document.querySelectorAll('.raku-tabs__item');
        for (var j = 0; j < tabs.length; j++) {
          var t = tabs[j];
          var sel = t.getAttribute('data-raku-tab') === name;
          if (sel) { t.classList.add('is-active'); t.setAttribute('aria-selected', 'true'); t.setAttribute('tabindex', '0'); }
          else { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); t.setAttribute('tabindex', '-1'); }
        }
      }
    };
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') { return; }
      // Issue #83: 修飾キー付き矢印（Alt+←/→の戻る・進む等）はブラウザに譲る。
      if (e.altKey || e.ctrlKey || e.metaKey) { return; }
      var tab = e.target && e.target.closest ? e.target.closest('.raku-tabs__item') : null;
      if (!tab || !tab.closest('.raku-tabs')) { return; }
      e.preventDefault();
      var tabs = Array.prototype.slice.call(tab.closest('.raku-tabs').querySelectorAll('.raku-tabs__item'));
      var idx = tabs.indexOf(tab);
      var next = e.key === 'ArrowRight' ? (idx + 1) % tabs.length : (idx - 1 + tabs.length) % tabs.length;
      tabs[next].focus();
      var name = tabs[next].getAttribute('data-raku-tab');
      if (name) { window.RakuTabs.show(name); }
    });

