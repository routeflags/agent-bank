#header-menu-toggle-menu.toggle-menu.header-toggle-menu-menu.hidden

  -# Mobile auth — デスクトップの .top-actions と同じ遷移先（ID重複を避けるため id 無し）
  - if logged_in
    = link_to profile_path do
      = icon_map_tag(icons, "user", ["icon-with-text"])
      = t("lamprey.header.mypage")
    = link_to logout_path do
      = icon_map_tag(icons, "logout", ["icon-with-text"])
      = t("layouts.logged_in.logout")
  - else
    = link_to login_path, class: "raku-nav__login" do
      = t("lamprey.header.login")
    = link_to sign_up_path, class: "raku-nav__signup" do
      = t("lamprey.header.signup")

  -# Primary navigation (hidden on desktop where the inline nav shows it).
  -# デスクトップの .topbar-nav と同一の4項目＋既存ルートのランキング/バトル。
  -# 現在のセクションはデスクトップと同じ `raku_nav_active?` で判定して
  -# `is-active` を付ける（Issue #124: ランキング/バトルはここにしかリンクが
  -# 無いため、ここで active を出さないと現在地が分からない）。
  .hidden-desktop
    = link_to landing_page_path, class: "toggle-menu-link#{' is-active' if raku_nav_active?(:marketplace)}" do
      = t("lamprey.header.nav_marketplace")
    = link_to browse_path, class: "toggle-menu-link#{' is-active' if raku_nav_active?(:browse)}" do
      = t("lamprey.header.nav_agents")
    = link_to new_listing_path, class: "toggle-menu-link#{' is-active' if raku_nav_active?(:new_listing)}" do
      = t("lamprey.header.nav_sell")
    = link_to docs_path, class: "toggle-menu-link#{' is-active' if raku_nav_active?(:docs)}" do
      = t("lamprey.header.nav_docs")
    = link_to rankings_path, class: "toggle-menu-link#{' is-active' if raku_nav_active?(:rankings)}" do
      = t("lamprey.header.nav_rankings")
    = link_to battles_path, class: "toggle-menu-link#{' is-active' if raku_nav_active?(:battles)}" do
      = t("lamprey.header.nav_battles")

  - if @current_community.configuration.display_about_menu?
    = link_to about_infos_path do
      = icon_map_tag(icons, "information", ["icon-with-text"])
      = t("header.about")

  - if @current_community.configuration.display_contact_menu?
    = link_to new_user_feedback_path do
      = icon_map_tag(icons, "feedback", ["icon-with-text"])
      = t("header.contact_us")

  - if @current_community.configuration.display_invite_menu?
    - with_invite_link do
      = link_to new_invitation_path do
        = icon_map_tag(icons, "invite", ["icon-with-text"])
        = t("header.invite")

  - Maybe(@current_community).menu_links.each do |menu_links|
    - menu_links.each do |menu_link|
      = link_to menu_link.url(I18n.locale), :target => "_blank" do
        = icon_map_tag(icons, "redirect", ["icon-with-text"])
        = menu_link.title(I18n.locale)

  - if @current_user && @current_community && @current_user.has_admin_rights?(@current_community)
    = link_to admin2_path do
      = icon_map_tag(icons, "admin", ["icon-with-text"])
      = t("layouts.logged_in.admin")

  .hidden-desktop
    - if available_locales.size > 1
      .toggle-menu-title
        = t("layouts.global-header.select_language")

      - locale_change_links.each do |locale_change_link|
        %a{href: locale_change_link[:url]}
          = locale_change_link[:title]
