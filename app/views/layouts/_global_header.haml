-# 楽市楽間 — Dark Theme Global Header
%header.header.raku-header
  .header-wrapper
    -# Logo (left side)
    .header-left.header-logo-container
      = link_to landing_page_path, :class => "header-logo", :id => "header-logo" do
        %span.header-wide-logo-text 楽市楽間

    -# Desktop/tablet compact search (DESIGN.md §7/§11)
    .header-search.visible-tablet
      = form_tag landing_page_path, method: :get, class: "header-search__form" do
        = text_field_tag :q, params[:q], class: "header-search__input", placeholder: t("homepage.index.what_do_you_need"), aria: { label: t("lamprey.header.search_label") }
        = button_tag type: :submit, class: "header-search__button", aria: { label: t("lamprey.header.search_submit") } do
          🔍

    -# Desktop auth / actions (right side)
    .header-right.header-padding.visible-tablet
      = link_to t("homepage.index.post_new_listing"), new_listing_path, :class => "new-listing-link", :id => "new-listing-link"

    - if logged_in
      .header-right
        = render :partial => "layouts/header_anchors", locals: {avatar_url: avatar_url, current_user_name: current_user_name, icons: icons}
        = render :partial => "layouts/header_user_menu", locals: {unread_count: unread_count, inbox_path: inbox_path, profile_path: profile_path, manage_listings_path: manage_listings_path, settings_path: settings_path, logout_path: logout_path, icons: icons}
      = render :partial => "layouts/header_right_visible_tablet", locals: {unread_count: unread_count, inbox_path: inbox_path, icons: icons}

    - if available_locales.size > 1
      .header-right.visible-desktop
        #header-locales-menu.toggle.header-hover{data: {toggle: '#header-locales-toggle-menu', 'toggle-position' => 'absolute'}}
          %span.header-text-link
            = current_locale_name
            = icon_map_tag(icons, "dropdown", ["icon-dropdown"])
        #header-locales-toggle-menu.toggle-menu.header-toggle-menu-language.hidden
          - locale_change_links.each do |locale_change_link|
            %a{href: locale_change_link[:url]}
              = locale_change_link[:title]

    - unless logged_in
      .header-right
        = link_to login_path, class: "raku-nav__login", id: "header-login-link" do
          = t("lamprey.header.login")
      .header-right
        = link_to sign_up_path, class: "raku-nav__signup" do
          = t("lamprey.header.signup")

    -# Mobile hamburger
    .header-left.hidden-tablet
      .header-menu-container.toggle.hidden{data: {toggle: '#header-menu-toggle-menu', 'toggle-position' => 'absolute'}}
        #header-menu-mobile-anchor.header-menu-toggle-container.toggle-header-container
          = icon_map_tag(icons, "rows", ["header-menu-icon"])

    = render :partial => "layouts/header_menu", locals: { locale_change_links: locale_change_links, icons: icons}

  -# ── Sub navigation bar ──────────────────────────────────
  .raku-nav
    .raku-nav__inner
      = link_to landing_page_path, class: "raku-nav__link#{' is-active' if raku_nav_active?(:marketplace)}" do
        %span.raku-nav__icon 🔍
        = t("lamprey.header.nav_marketplace")
      = link_to new_listing_path, class: "raku-nav__link#{' is-active' if raku_nav_active?(:new_listing)}" do
        %span.raku-nav__icon 📦
        = t("lamprey.header.nav_new_listing")
      = link_to rankings_path, class: "raku-nav__link#{' is-active' if raku_nav_active?(:rankings)}" do
        %span.raku-nav__icon 🏆
        = t("lamprey.header.nav_rankings")
      = link_to battles_path, class: "raku-nav__link#{' is-active' if raku_nav_active?(:battles)}" do
        %span.raku-nav__icon ⚔️
        = t("lamprey.header.nav_battles")
      = link_to docs_path, class: "raku-nav__link#{' is-active' if raku_nav_active?(:docs)}" do
        %span.raku-nav__icon 📚
        = t("lamprey.header.nav_docs")
