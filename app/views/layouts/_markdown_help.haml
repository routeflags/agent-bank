= render :layout => "layouts/lightbox", locals: {id: "markdown-help-popup", field: nil, labelledby: "markdown-help-popup-title"} do
  -# ライトボックスの見出し兼アクセシブル名（aria-labelledby の参照先）。
  -# ライトボックス内の見出しは h2 以下で構成する（h2 の後に h1 を出さない）。
  %h2{:id => "markdown-help-popup-title"}= t("layouts.markdown_help.title")

  %p= t("layouts.markdown_help.description")

  %table.markdown-help-table
    %tbody
      %tr
        %th= t("layouts.markdown_help.formatting")
        %th= t("layouts.markdown_help.result")
      %tr
        %td
          = format("# %s", t("layouts.markdown_help.h1"))
          %br>/
          = format("## %s", t("layouts.markdown_help.h2"))
          %br>/
          = format("### %s", t("layouts.markdown_help.h3"))
        %td
          -# 結果列は「見出しで書くとこう見える」という見本。実際の見出しタグを
          -# 使うと見出しアウトラインが壊れる（h2 の後に h1）ため、見た目を保った
          -# まま div + クラスに置換している（Issue #132）。
          %div.markdown-help-heading.markdown-help-heading--h1= t("layouts.markdown_help.h1")
          %br/
          %div.markdown-help-heading.markdown-help-heading--h2= t("layouts.markdown_help.h2")
          %br/
          %div.markdown-help-heading.markdown-help-heading--h3= t("layouts.markdown_help.h3")
      %tr
        %td= format("*%s*", t("layouts.markdown_help.italic"))
        %td
          %i= t("layouts.markdown_help.italic")
      %tr
        %td= format("**%s**", t("layouts.markdown_help.bold"))
        %td
          %b= t("layouts.markdown_help.bold")
      %tr
        %td= format("_%s_", t("layouts.markdown_help.underline"))
        %td
          %u= t("layouts.markdown_help.underline")
      %tr
        %td= format("~~%s~~", t("layouts.markdown_help.strikethrough"))
        %td
          %strike= t("layouts.markdown_help.strikethrough")
      %tr
        %td= format("[%s](https://www.example.com)", t("layouts.markdown_help.inline_link"))
        %td
          %a{:href => "https://www.example.com", :target => "_blank"}= t("layouts.markdown_help.inline_link")
      %tr
        %td
          = format("- %s", t("layouts.markdown_help.list"))
          %br>/
          = format("- %s", t("layouts.markdown_help.list"))
          %br>/
          = format("- %s", t("layouts.markdown_help.list"))
        %td
          %ul
            %li
              = t("layouts.markdown_help.list")
              %br/
              %br/
            %li
              = t("layouts.markdown_help.list")
              %br/
              %br/
            %li
              = t("layouts.markdown_help.list")
              %br/
      %tr
        %td
          = format("1. %s", t("layouts.markdown_help.one"))
          %br/
          = format("2. %s", t("layouts.markdown_help.two"))
          %br/
          = format("3. %s", t("layouts.markdown_help.three"))
        %td
          %ol
            %li
              = t("layouts.markdown_help.one")
              %br/
              %br/
            %li
              = t("layouts.markdown_help.two")
              %br/
              %br/
            %li
              = t("layouts.markdown_help.three")
              %br/
              %br/

- content_for :markdown_help_javascript do
  :javascript
    (function() {
      var $trigger = $('#markdown-popup-link');
      var $dialog = $('#markdown-help-popup');
      var FOCUSABLE = 'a[href], area[href], button, input, select, textarea, iframe, [tabindex]:not([tabindex="-1"])';
      var TRAP_NS = 'keydown.markdownHelpA11y';

      function focusableInDialog() {
        return $dialog.find(FOCUSABLE).filter(':visible');
      }

      // Tab / Shift+Tab をダイアログ内で循環させる（aria-modal="true" の前提を
      // キーボード操作でも満たすため）。
      function keepFocusInside(e) {
        if (e.which !== 9) { return; }
        var $focusable = focusableInDialog();
        if (!$focusable.length) { e.preventDefault(); return; }
        var first = $focusable[0];
        var last = $focusable[$focusable.length - 1];

        // ダイアログ本体（tabindex="-1"）にフォーカスがあるときは、
        // 先頭／末尾へ明示的に送る（ダイアログは body の末尾に移動されるため、
        // そのまま Tab を押すとダイアログの外へ抜けてしまう）。
        if (e.target === $dialog[0]) {
          e.preventDefault();
          (e.shiftKey ? last : first).focus();
        } else if (e.shiftKey && e.target === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && e.target === last) {
          e.preventDefault();
          first.focus();
        }
      }

      $trigger.on('click', function() {
        // Esc での閉じは lightbox_me の既定動作（closeEsc: true）が受け持つ。
        // onLoad / onClose でフォーカスだけをここで面倒にする。
        $dialog.lightbox_me({
          centered: true,
          zIndex: 1000000,
          onLoad: function() {
            $dialog.on(TRAP_NS, keepFocusInside);
            $dialog.focus();
          },
          onClose: function() {
            $dialog.off(TRAP_NS);
            $trigger.focus();
          }
        });
        return false;
      });
    })();

- if defined?(run_js_immediately) && run_js_immediately
  = yield :markdown_help_javascript
- content_for :extra_javascript do
  = yield :markdown_help_javascript

