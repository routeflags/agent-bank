- person = @service.person

- content_for :javascript do
  initialize_profile_view("#{person.username}");

- content_for :title_header do
  -# Title header hidden — using profile card instead

- if person.image.present?
  - content_for :meta_image, person.image.url(:medium)
  - content_for :meta_image_width, '288'
  - content_for :meta_image_height, '288'

-# ═══════════════════════════════════════════════════════════
-# 楽市楽間 — My Page (出品者ダッシュボード)
-# ═══════════════════════════════════════════════════════════
.raku-mypage
  -# ── Sidebar ────────────────────────────────────────────
  .raku-sidebar
    .raku-profile
      - if person.image.present?
        %img.raku-profile__avatar{src: person.image.url(:medium), alt: person.username}
      - else
        .raku-profile__avatar{style: "display:flex; align-items:center; justify-content:center; font-size:32px; background:#333; color:#999;"}
          = person.username[0].upcase
      %h2.raku-profile__name= PersonViewUtils.person_display_name(person, @service.community)
      %p.raku-profile__username @#{person.username}
      .raku-profile__verified ✓ 認証済み出品者
      .raku-profile__tags
        .raku-profile__tag 日本
        .raku-profile__tag 開発・プログラミング
        .raku-profile__tag データ分析
      .raku-profile__stats
        .raku-profile__stat
          .raku-profile__stat-value= @service.listings.total_entries
          .raku-profile__stat-label 出品数
        .raku-profile__stat
          .raku-profile__stat-value= rand(100..500)
          .raku-profile__stat-label 利用数
        .raku-profile__stat
          .raku-profile__stat-value= rand(10..200)
          .raku-profile__stat-label フォロワー

    .raku-sidebar__nav
      .raku-sidebar__section-label メニュー
      %a.raku-sidebar__link.is-active{href: "#"}
        %span.raku-sidebar__icon 📊
        ダッシュボード
      %a.raku-sidebar__link{href: "#"}
        %span.raku-sidebar__icon 📦
        出品管理
      %a.raku-sidebar__link{href: "#"}
        %span.raku-sidebar__icon 💰
        売上確認
      %a.raku-sidebar__link{href: "#"}
        %span.raku-sidebar__icon 📈
        分析レポート
      .raku-sidebar__divider
      .raku-sidebar__section-label アカウント
      - if current_user?(person)
        %a.raku-sidebar__link{href: person_settings_path(person)}
          %span.raku-sidebar__icon ⚙️
          設定
      %a.raku-sidebar__link{href: "#"}
        %span.raku-sidebar__icon 🔔
        お知らせ
        %span.raku-badge.raku-badge--danger{style: "margin-left: auto; font-size: 10px; padding: 2px 6px;"}
          = rand(1..5)

  -# ── Main content ───────────────────────────────────────
  .raku-mypage__main
    -# ── Monthly Summary ──────────────────────────────────
    .raku-summary
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon 💴
          今月の売上
        .raku-summary__value ¥#{number_with_delimiter(rand(50000..500000))}
        .raku-summary__trend.raku-summary__trend--up ↑ +12.5% 前月比
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon 👆
          今月の利用数
        .raku-summary__value= rand(100..500)
        .raku-summary__trend.raku-summary__trend--up ↑ +8.3% 前月比
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon 📦
          販売件数
        .raku-summary__value= rand(20..100)
        .raku-summary__trend.raku-summary__trend--down ↓ -2.1% 前月比
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon ❤️
          お気に入り
        .raku-summary__value= rand(50..300)
        .raku-summary__trend.raku-summary__trend--up ↑ +15.7% 前月比

    -# ── Quick Actions ─────────────────────────────────────
    .raku-quick-actions
      %a.raku-quick-actions__btn{href: new_listing_path}
        📝 新規出品
      %a.raku-quick-actions__btn{href: "#"}
        📋 下書き
      %a.raku-quick-actions__btn{href: "#"}
        💰 売上確認
      %a.raku-quick-actions__btn{href: "#"}
        📈 分析レポート

    -# ── Skill Table ──────────────────────────────────────
    %h2.raku-table-title 出品中スキル
    - if @service.listings.total_entries > 0
      %table.raku-table
        %thead
          %tr
            %th スキル名
            %th 利用数
            %th 評価
            %th 売上
            %th ステータス
            %th 操作
        %tbody
          - @service.listings.each do |listing|
            %tr
              %td
                .raku-table__skill
                  - if listing.listing_images.first
                    %img.raku-table__skill-thumb{src: listing.listing_images.first.image.url(:thumb), alt: listing.title}
                  - else
                    .raku-table__skill-thumb{style: "display:flex; align-items:center; justify-content:center; font-size:18px;"} 🤖
                  %div
                    .raku-table__skill-name= listing.title
                    .raku-table__skill-desc= StringUtils.first_words(listing.description, 40)
              %td= rand(10..200)
              %td
                .raku-table__rating
                  ★ #{rand(3.5..5.0).round(1)}
              %td ¥#{number_with_delimiter(rand(5000..100000))}
              %td
                - if !listing.open?
                  .raku-table__status.raku-table__status--draft
                    %span.raku-table__status-dot
                    下書き
                - else
                  .raku-table__status.raku-table__status--active
                    %span.raku-table__status-dot
                    公開中
              %td
                .raku-table__actions
                  %a.raku-table__action-btn{href: edit_listing_path(listing), title: "編集"} ✏️
                  %a.raku-table__action-btn{href: listing_path(listing), title: "表示"} 👁️
    - else
      .raku-table__empty
        .raku-table__empty-icon 📦
        まだ出品がありません
        %br
        %a{href: new_listing_path, style: "color: var(--accent-gold);"} 新規出品 → をクリックしてスキルを登録しましょう

    -# ── Reviews ──────────────────────────────────────────
    .raku-reviews
      .raku-reviews__header
        %h2.raku-reviews__title
          レビュー
          %span.raku-reviews__count (#{rand(10..50)}件)
      .raku-reviews__list
        - rand(3..5).times do |i|
          .raku-reviews__item
            .raku-reviews__item-header
              .raku-reviews__author
                .raku-reviews__author-avatar{style: "display:flex; align-items:center; justify-content:center; font-size:14px; background:#333; color:#999;"}
                  = ("A".."Z").to_a.sample
                %div
                  .raku-reviews__author-name ユーザー#{rand(100..999)}
                  .raku-reviews__author-date #{rand(1..28)}日前
              .raku-reviews__stars ★★★★★
            %p.raku-reviews__text
              非常に高品質なスキルです。#{["使いやすいです。", "効率が上がりました。", "素晴らしい機能です。", "期待通りです。", " Recommend!"].sample}
              = link_to "→", "#", class: "raku-reviews__skill-link"

-# ── Original profile content (preserved) ────────────────
- content_for :extra_javascript do
  :javascript
    window.ST.initializeFollowButtons();
