- person = @service.person

- content_for :javascript do
  initialize_profile_view("#{person.username}");

- content_for :title_header do
  -# Title header hidden — using profile card instead

- if person.image.present?
  - content_for :meta_image, person.image.url(:medium)
  - content_for :meta_image_width, '288'
  - content_for :meta_image_height, '288'

-# ═══════════════════════════════════════════════════════════
-# 楽市楽間 — My Page (出品者ダッシュボード)
-# ═══════════════════════════════════════════════════════════
.raku-mypage
  -# ── Sidebar ────────────────────────────────────────────
  .raku-sidebar
    .raku-profile
      - if person.image.present?
        %img.raku-profile__avatar{src: person.image.url(:medium), alt: person.username}
      - else
        .raku-profile__avatar.raku-avatar-placeholder
          = person.username[0].upcase
      %h2.raku-profile__name= PersonViewUtils.person_display_name(person, @service.community)
      %p.raku-profile__username @#{person.username}
      .raku-profile__verified= t('lamprey.mypage.verified_seller')
      .raku-profile__tags
        - t('lamprey.mypage.profile_tags').each do |tag|
          .raku-profile__tag= tag
      .raku-profile__stats
        .raku-profile__stat
          .raku-profile__stat-value= @raku_stats[:published]
          .raku-profile__stat-label= t('lamprey.mypage.stats_published')
        .raku-profile__stat
          .raku-profile__stat-value= number_with_delimiter(@raku_stats[:total_views])
          .raku-profile__stat-label= t('lamprey.mypage.stats_total_views')
        .raku-profile__stat
          .raku-profile__stat-value= number_with_delimiter(@raku_stats[:total_sold])
          .raku-profile__stat-label= t('lamprey.mypage.stats_total_sold')

    .raku-sidebar__nav
      .raku-sidebar__section-label= t('lamprey.mypage.menu')
      %a.raku-sidebar__link.is-active{href: person_path(username: person.username)}
        %span.raku-sidebar__icon 📊
        = t('lamprey.mypage.dashboard')
      %a.raku-sidebar__link{href: person_path(username: person.username, show_closed: true)}
        %span.raku-sidebar__icon 📦
        = t('lamprey.mypage.manage_listings')
      .raku-sidebar__divider
      .raku-sidebar__section-label= t('lamprey.mypage.account')
      - if current_user?(person)
        %a.raku-sidebar__link{href: person_settings_path(person)}
          %span.raku-sidebar__icon ⚙️
          = t('lamprey.mypage.settings')

  -# ── Main content ───────────────────────────────────────
  .raku-mypage__main
    -# ── Summary（実データのみ。偽トレンドは非表示 — DESIGN.md §25.10） ──
    .raku-summary
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon 📦
          = t('lamprey.mypage.summary_published')
        .raku-summary__value= @raku_stats[:published]
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon 💰
          = t('lamprey.mypage.summary_total_sold')
        .raku-summary__value= number_with_delimiter(@raku_stats[:total_sold])
      .raku-summary__item
        .raku-summary__label
          %span.raku-summary__icon 👆
          = t('lamprey.mypage.summary_total_views')
        .raku-summary__value= number_with_delimiter(@raku_stats[:total_views])
      - if @raku_stats[:avg_rating]
        .raku-summary__item
          .raku-summary__label
            %span.raku-summary__icon ★
            = t('lamprey.mypage.summary_avg_rating')
          .raku-summary__value
            %span.raku-link-gold= "★ #{@raku_stats[:avg_rating]}"

    -# ── Quick Actions（未実装ページへのリンクは置かない — §25.10） ──
    .raku-quick-actions
      %a.raku-quick-actions__btn{href: new_listing_path}
        = "📝 #{t('lamprey.mypage.new_listing')}"
      %a.raku-quick-actions__btn{href: person_path(username: person.username, show_closed: true)}
        = "📋 #{t('lamprey.mypage.manage_listings')}"

    -# ── Skill Table ──────────────────────────────────────
    %h2.raku-table-title= t('lamprey.mypage.table_title')
    - if @skill_listings.total_entries > 0
      %table.raku-table
        %thead
          %tr
            %th= t('lamprey.mypage.th_skill')
            %th= t('lamprey.mypage.th_views')
            %th= t('lamprey.mypage.th_rating')
            %th= t('lamprey.mypage.th_price')
            %th= t('lamprey.mypage.th_status')
            %th= t('lamprey.mypage.th_actions')
        %tbody
          - @skill_listings.each do |listing|
            %tr
              %td
                .raku-table__skill
                  - if (listing_image = listing.listing_images.first)
                    %img.raku-table__skill-thumb{src: listing_image.image.url(:thumb), alt: listing.title}
                  - else
                    .raku-table__skill-thumb.raku-thumb-placeholder 🤖
                  %div
                    .raku-table__skill-name= link_to listing.title, listing_path(listing), class: "raku-table__skill-link"
                    .raku-table__skill-desc= StringUtils.first_words(listing.description, 40)
              %td= number_with_delimiter(listing.times_viewed.to_i)
              %td
                .raku-table__rating
                  - if listing.avg_rating.to_f > 0
                    = "★ #{listing.avg_rating.round(1)}"
                  - else
                    = "—"
              %td= number_to_currency(listing.price_cents.to_i / 100.0, unit: "¥", precision: 0, delimiter: ",")
              %td
                - if listing.open?
                  .raku-table__status.raku-table__status--active
                    %span.raku-table__status-dot
                    = t('lamprey.mypage.status_published')
                - else
                  .raku-table__status
                    %span.raku-table__status-dot
                    = t('lamprey.mypage.status_closed')
              %td
                .raku-table__actions
                  %a.raku-table__action-btn{href: edit_listing_path(listing), title: t('lamprey.mypage.action_edit')} ✏️
                  %a.raku-table__action-btn{href: listing_path(listing), title: t('lamprey.mypage.action_view')} 👁️
    - else
      .raku-table__empty
        .raku-table__empty-icon 📦
        = t('lamprey.mypage.empty_listings')
        %br
        %a.raku-link-gold{href: new_listing_path}= t('lamprey.mypage.empty_listings_cta')

    -# ── Reviews ──────────────────────────────────────────
    .raku-reviews
      .raku-reviews__header
        %h2.raku-reviews__title
          = t('lamprey.mypage.reviews_title')
          %span.raku-reviews__count= t('lamprey.mypage.reviews_count', count: 0)
      .raku-reviews__list
        .raku-reviews__empty
          = t('lamprey.mypage.reviews_empty')

-# ── Original profile content (preserved) ────────────────
- content_for :extra_javascript do
  :javascript
    window.ST.initializeFollowButtons();
