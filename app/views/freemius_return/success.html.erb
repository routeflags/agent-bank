<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= t("lamprey.freemius_return.success_title") %></title>
  <style>
    body { font-family: sans-serif; max-width: 640px; margin: 48px auto; padding: 0 16px; line-height: 1.7; }
    .card { border: 1px solid #ddd; border-radius: 12px; padding: 24px; }
    .warn { background: #fff8e1; border: 1px solid #f0c36d; border-radius: 8px; padding: 12px 16px; margin-top: 16px; }
    .actions { margin-top: 20px; }
    .actions a { display: inline-block; margin-right: 12px; }
  </style>
</head>
<body>
  <div class="card">
    <h1><%= t("lamprey.freemius_return.success_title") %></h1>
    <p><%= t("lamprey.freemius_return.success_body") %></p>
    <p><%= t("lamprey.freemius_return.pending_note") %></p>
    <% unless @verification[:valid] %>
      <div class="warn"><%= t("lamprey.freemius_return.invalid_signature") %></div>
    <% end %>
    <div class="actions">
      <a href="/<%= I18n.locale %>/"><%= t("lamprey.freemius_return.back_to_top") %></a>
    </div>
  </div>
</body>
</html>
