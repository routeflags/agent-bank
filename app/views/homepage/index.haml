- content_for :javascript do
  initialize_homepage();

- content_for :coverfade_class do
  = "without-text"

- content_for :extra_javascript do
  :javascript
    // 楽市楽問 — 注目のペルソナ横スクロールスライダー（矢印 + ドラッグ + 自動送り）
    // PageSpeed 配慮: 追加ライブラリなし・レイアウトシフトなし。タブ非表示時、
    // 画面外、ホバー/フォーカス/ドラッグ中、および reduced-motion 指定時は
    // 自動送りを停止してメインスレッドとバッテリーへの影響を最小化する。
    window.RakuFeatured = {
      scrollEl: function () { return document.getElementById('raku-featured-scroll'); },
      step: function () {
        var el = this.scrollEl();
        if (!el) return 296;
        var card = el.querySelector('.raku-featured__card');
        return card ? (card.offsetWidth + 16) : 296;
      },
      slide: function (dir) {
        var el = this.scrollEl();
        if (!el) return;
        el.scrollBy({ left: dir * this.step(), behavior: 'smooth' });
      }
    };
    (function () {
      var el = window.RakuFeatured.scrollEl();
      if (!el) return;

      var motionQuery = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : null;
      var hovering = false;    // ホバー中
      var focused = false;     // フォーカス中
      var dragging = false;    // ドラッグ中
      var visible = true;      // 画面内か
      var intervalId = null;
      var AUTO_MS = 5000;

      function isPaused() { return hovering || focused || dragging || document.hidden; }

      // ドラッグでスクロール
      var down = false, startX = 0, startScroll = 0;
      el.addEventListener('mousedown', function (e) {
        down = true; dragging = true; startX = e.pageX; startScroll = el.scrollLeft;
        el.classList.add('is-dragging');
      });
      window.addEventListener('mouseup', function () {
        if (!down) return;
        down = false; dragging = false;
        el.classList.remove('is-dragging');
      });
      window.addEventListener('mousemove', function (e) {
        if (!down) return;
        e.preventDefault();
        el.scrollLeft = startScroll - (e.pageX - startX);
      });

      // 端まで来たら先頭へ戻す
      function advance() {
        if (isPaused() || !visible) return;
        var max = el.scrollWidth - el.clientWidth;
        if (max <= 0) return;
        if (el.scrollLeft >= max - 4) {
          el.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          el.scrollBy({ left: window.RakuFeatured.step(), behavior: 'smooth' });
        }
      }

      function start() {
        if (intervalId || (motionQuery && motionQuery.matches)) return;
        intervalId = window.setInterval(advance, AUTO_MS);
      }
      function stop() {
        if (intervalId) { window.clearInterval(intervalId); intervalId = null; }
      }

      // ホバー / フォーカス中は停止（ユーザー操作を妨げない）
      el.addEventListener('mouseenter', function () { hovering = true; });
      el.addEventListener('mouseleave', function () { hovering = false; });
      el.addEventListener('focusin', function () { focused = true; });
      el.addEventListener('focusout', function () { focused = false; });

      // タブが非表示の間は停止（バックグラウンド処理を排除）
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { stop(); } else { start(); }
      });

      // 画面外では停止（不要なスクロール処理を排除）
      if (window.IntersectionObserver) {
        new IntersectionObserver(function (entries) {
          visible = entries[0].isIntersecting;
          if (visible) { start(); } else { stop(); }
        }, { threshold: 0.1 }).observe(el);
      }

      // OS の「視差効果を減らす」設定に追従
      if (motionQuery && motionQuery.addEventListener) {
        motionQuery.addEventListener('change', function (e) {
          if (e.matches) { stop(); } else { start(); }
        });
      }

      start();
    })();

    // 楽市楽問 — `/` キーでヒーローの検索欄へフォーカス（Issue #108）。
    // 入力欄・セレクト・テキストエリアにフォーカスがある場合は何もしない。
    // ヒーローが無い画面（/browse）ではクエリ欄が無いためガードする。
    (function () {
      document.addEventListener('keydown', function (e) {
        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
        var tag = document.activeElement && document.activeElement.tagName;
        if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
        var query = document.getElementById('raku-hero-query');
        if (!query) return;
        e.preventDefault();
        query.focus();
      });
    })();

-# ═══════════════════════════════════════════════════════════
-# ヒーロー/統計/カテゴリ（トップ用）— 一覧ページ(/browse)では非表示
- unless @listing_page
  = render "homepage/intro"


-# ═══════════════════════════════════════════════════════════
-# Original search / listing grid (preserved from Sharetribe)
-# ═══════════════════════════════════════════════════════════
- is_homepage = params[:controller] == "homepage" && params[:action] == "index"

- if @current_community.private? && @big_cover_photo
  - if @community_customization && @community_customization.private_community_homepage_content
    .community-customization-wrapper
      = @community_customization.private_community_homepage_content.html_safe
  - else
    = t(".this_is_private_community")
- else
  - if @listing_page
    .row
      - if @category_menu_enabled
        .col-3.visible-tablet
          - if @show_categories
            .row
              .col-12
                = link_to t("homepage.filters.all_categories"), browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: "all"})), :class => "home-categories-main #{if selected_category.nil? then 'selected' end}"
                - @main_categories.each do |category|
                  - show_subcategories = show_subcategory_list(category, Maybe(selected_category).id.to_i.or_else(nil))
                  = link_to @category_display_names[category.id], browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: category})), :class => "home-categories-main #{if show_subcategories then 'selected' end} #{if category.has_subcategories? then 'has-subcategories' end}", :data => {category: category.id}
                  - if category.children
                    - if show_subcategories
                      - category.children.each do |child|
                        - is_selected = selected_category == child
                        = link_to @category_display_names[child.id], browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: child})), :class => "home-categories-sub #{if is_selected then 'selected' end}", :data => {:"sub-category" =>child.id}

          #desktop-filters

      - main_container_class = if @category_menu_enabled then "col-9" else "col-12" end
      %div{:class => main_container_class}
        - if @listings.total_entries > 0
          - if @view_type.eql?("map")
            .home-map
              = render :partial => "map", locals: { viewport: viewport }
          - else
            - if @view_type.eql?("grid")
              -# Issue #115: 一覧もトップと同じカード（article.product）で描画する。
              .cards
                = render partial: "homepage/persona_card", collection: @listings, as: :listing

            - else
              .home-listings
                - if (location_search_in_use)
                  = render partial: "list_item_with_distance", collection: @listings, as: :listing, locals: { shape_name_map: shape_name_map, show_distance: location_search_in_use }
                - else
                  = render partial: "list_item", collection: @listings, as: :listing, locals: { shape_name_map: shape_name_map }
            .home-loading-more
              = will_paginate(@listings, renderer: ListingPaginationRenderer)
              - item_container = if @view_type.eql?("grid") then '.cards' else '.home-listings' end
              = pageless(@listings.total_pages, item_container, current_search_path_without_page, t('.loading_more_content'), current_page)
        - else
          .home-no-listings
            - if params[:q] || params[:category] || params[:share_type]
              = t(".no_listings_with_your_search_criteria")
            - else
              = t(".no_listings_notification", add_listing_link: link_to(t(".add_listing_link_text"), new_listing_path(ref: "add_listing_link"))).html_safe

-# ── 注目のペルソナ ──────────────────────────
= render "homepage/featured"

-# ── トップのページ送り（Issue #111） ──────────────────────
-# トップは Sharetribe の一覧グリッドを描画しないため、will_paginate と
-# 無限スクロール（pageless）の付け替え先を新カードの .cards にする。
-# /browse は従来どおり .home-fluid-thumbnail-grid / .home-listings が対象。
- unless @listing_page
  - if !(@current_community.private? && @big_cover_photo) && @listings.total_entries > 0
    .home-loading-more
      = will_paginate(@listings, renderer: ListingPaginationRenderer)
      = pageless(@listings.total_pages, '.cards', current_search_path_without_page, t('.loading_more_content'), current_page)

-# ── 使い方・導線（フッター直上、Issue #108） ──────────────────────────
= render "homepage/features"

-# ── サイトフッター（トップのみ、Issue #112） ───────────────────────────
- unless @listing_page
  = render "homepage/site_footer"
