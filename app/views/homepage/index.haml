- content_for :javascript do
  initialize_homepage();

- content_for :coverfade_class do
  = "without-text"

- content_for :extra_javascript do
  - maps_key = MarketplaceHelper.google_maps_key(@current_community.id)
  - key_param = maps_key ? "&key=#{maps_key}" : ""
  - needs_maps = !FeatureFlagHelper.feature_enabled?(:topbar_v1) && (main_search != :keyword || @view_type.eql?("map"))
  - if(needs_maps)
    = javascript_include_tag "//maps.googleapis.com/maps/api/js?libraries=places#{key_param}"
  - if(@view_type.eql?("map"))
    = javascript_include_tag "markerclusterer.js"

- content_for :title_header do
  -# Title header is now handled by the hero section below

-# ═══════════════════════════════════════════════════════════
-# 楽市楽間 — Hero Section
-# ═══════════════════════════════════════════════════════════
.raku-hero
  .raku-hero__badge
    🚀
    = t('lamprey.homepage.hero_tagline')
  %h1.raku-hero__title
    = t('lamprey.homepage.hero_title')
  %p.raku-hero__subtitle
    = t('lamprey.homepage.hero_subtitle')

  -# Search bar
  %form.raku-hero__search{action: search_path, method: "get"}
    .raku-hero__search-type
      = t('lamprey.homepage.search_type_all')
      %svg{viewBox: "0 0 20 20", fill: "currentColor"}
        %path{d: "M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"}
    %input.raku-hero__search-input{type: "text", name: "q", placeholder: t('lamprey.homepage.search_placeholder')}
    %button.raku-hero__search-btn{type: "submit"}
      %svg{viewBox: "0 0 20 20", fill: "currentColor"}
        %path{d: "M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"}

  -# Popular search tags
  .raku-hero__tags
    = link_to "SEO", search_path(q: "SEO"), class: "raku-hero__tag"
    = link_to "データ分析", search_path(q: "データ分析"), class: "raku-hero__tag"
    = link_to "記事生成", search_path(q: "記事生成"), class: "raku-hero__tag"
    = link_to "画像生成", search_path(q: "画像生成"), class: "raku-hero__tag"
    = link_to "要約", search_path(q: "要約"), class: "raku-hero__tag"
    = link_to "自動化", search_path(q: "自動化"), class: "raku-hero__tag"
    = link_to "翻訳", search_path(q: "翻訳"), class: "raku-hero__tag"
    = link_to "プログラミング", search_path(q: "プログラミング"), class: "raku-hero__tag"

-# ═══════════════════════════════════════════════════════════
-# Stats Bar
-# ═══════════════════════════════════════════════════════════
- open_listing_count = @current_community.listings.where(open: true).count
- user_count = Person.count
- transaction_count = Transaction.count

.raku-stats
  .raku-stats__item
    %span.raku-stats__icon 🤖
    .raku-stats__value= open_listing_count
    .raku-stats__label= t('lamprey.homepage.stats_agents')
  .raku-stats__item
    %span.raku-stats__icon 👥
    .raku-stats__value= user_count
    .raku-stats__label= t('lamprey.homepage.stats_users')
  .raku-stats__item
    %span.raku-stats__icon 💰
    .raku-stats__value= number_with_delimiter(transaction_count)
    .raku-stats__label= t('lamprey.homepage.stats_transactions')

-# ═══════════════════════════════════════════════════════════
-# Category Grid
-# ═══════════════════════════════════════════════════════════
.raku-categories
  %h2.raku-categories__title= t('lamprey.homepage.categories_title')
  .raku-categories__grid
    = link_to search_path(category: "generation-ai"), class: "raku-categories__item" do
      %span.raku-categories__icon 🎨
      %span.raku-categories__name= t('lamprey.homepage.category_generation_ai')
    = link_to search_path(category: "data-analysis"), class: "raku-categories__item" do
      %span.raku-categories__icon 📊
      %span.raku-categories__name= t('lamprey.homepage.category_data_analysis')
    = link_to search_path(category: "development"), class: "raku-categories__item" do
      %span.raku-categories__icon 💻
      %span.raku-categories__name= t('lamprey.homepage.category_development')
    = link_to search_path(category: "marketing"), class: "raku-categories__item" do
      %span.raku-categories__icon 📣
      %span.raku-categories__name= t('lamprey.homepage.category_marketing')
    = link_to search_path(category: "automation"), class: "raku-categories__item" do
      %span.raku-categories__icon ⚙️
      %span.raku-categories__name= t('lamprey.homepage.category_automation')
    = link_to search_path(category: "design"), class: "raku-categories__item" do
      %span.raku-categories__icon 🖼️
      %span.raku-categories__name= t('lamprey.homepage.category_design')
    = link_to search_path(category: "research"), class: "raku-categories__item" do
      %span.raku-categories__icon 🔬
      %span.raku-categories__name= t('lamprey.homepage.category_research')
    = link_to search_path(category: "education"), class: "raku-categories__item" do
      %span.raku-categories__icon 📖
      %span.raku-categories__name= t('lamprey.homepage.category_education')
    = link_to search_path(category: "writing"), class: "raku-categories__item" do
      %span.raku-categories__icon ✍️
      %span.raku-categories__name= t('lamprey.homepage.category_writing')
    = link_to search_path(category: "media"), class: "raku-categories__item" do
      %span.raku-categories__icon 🎵
      %span.raku-categories__name= t('lamprey.homepage.category_media')
    = link_to search_path(category: "other"), class: "raku-categories__item" do
      %span.raku-categories__icon 📁
      %span.raku-categories__name= t('lamprey.homepage.category_other')

-# ═══════════════════════════════════════════════════════════
-# Featured Cards
-# ═══════════════════════════════════════════════════════════
.raku-featured
  .raku-featured__header
    %h2.raku-featured__title= t('lamprey.homepage.featured_title')
    .raku-featured__tabs
      %button.raku-featured__tab.is-active{type: "button", data: {sort: "popular"}}= t('lamprey.homepage.tab_popular')
      %button.raku-featured__tab{type: "button", data: {sort: "newest"}}= t('lamprey.homepage.tab_newest')
      %button.raku-featured__tab{type: "button", data: {sort: "rating"}}= t('lamprey.homepage.tab_rating')
  .raku-featured__scroll
    - @listings.each do |listing|
      = link_to listing_path(listing.url), class: "raku-featured__card" do
        .raku-card
          - if listing.listing_images.first
            %img.raku-card__image{src: listing.listing_images.first[:small_3x2] || listing.listing_images.first[:thumb], alt: listing.title}
          - else
            .raku-card__image{style: "background: linear-gradient(135deg, #2a2a2a, #1e1e1e); display: flex; align-items: center; justify-content: center; font-size: 48px; color: #555;"} 🤖
          .raku-card__body
            %h3.raku-card__title= listing.title
            .raku-card__author
              - if listing.author
                %span= listing.author.display_name || listing.author.username
              - else
                %span 出品者
            %p.raku-card__description= StringUtils.first_words(listing.description, 60)
          .raku-card__footer
            .raku-card__rating
              %span{style: "color: #999; font-size: 12px;"}= t('lamprey.listings.rating_none')
            .raku-card__price
              - if listing.price
                = MoneyViewUtils.to_humanized(listing.price)
              - else
                = t('lamprey.listings.free')

    - if @listings.empty?
      .raku-featured__empty
        %p= t('lamprey.homepage.empty_title')
        %p= t('lamprey.homepage.empty_subtitle')

-# ═══════════════════════════════════════════════════════════
-# Original search / listing grid (preserved from Sharetribe)
-# ═══════════════════════════════════════════════════════════
- is_homepage = params[:controller] == "homepage" && params[:action] == "index"

- if @current_community.private? && @big_cover_photo
  - if @community_customization && @community_customization.private_community_homepage_content
    .community-customization-wrapper
      = @community_customization.private_community_homepage_content.html_safe
  - else
    = t(".this_is_private_community")
- else
  .home-toolbar
    - if listing_shape_menu_enabled || @category_menu_enabled
      .home-toolbar-show-filters-button-container
        .home-toolbar-show-filters-button#home-toolbar-show-filters
          = t(".filter")

    .home-toolbar-button-group{:class => listing_shape_menu_enabled || @category_menu_enabled ? "filters-enabled" : ""}
      - allowed_view_types.each do |view_type|
        - selected_class = @view_type == view_type ? "selected" : ""
        = link_to search_path(search_params.merge(view: view_type)), :class => "home-toolbar-button-group-button #{selected_class}", :title => t("homepage.filters.#{view_type}_button") do
          = icon_tag(view_type, ["icon-fix", "home-button-group-icon"])
          %span.home-toolbar-button-text
            = t("homepage.filters.#{view_type}_button")

    - if listing_shape_menu_enabled || @category_menu_enabled
      .home-toolbar-filters.home-toolbar-filters-mobile-hidden#home-toolbar-filters
        - if listing_shape_menu_enabled
          .toggle-container.home-toolbar-toggle-container
            .toggle.with-borders#home_toolbar-select-share-type{data: {toggle: '.home-toolbar-share-type-menu'}}
              .toggle-header-container
                .toggle-header
                  - if selected_shape
                    = t(selected_shape[:name_tr_key])
                  - else
                    = t("homepage.filters.all_listing_types")
                = icon_tag("dropdown", ["icon-dropdown"])
            .home-toolbar-share-type-menu.toggle-menu.hidden
              = link_to t("homepage.filters.all_listing_types"), search_path(search_params.merge({transaction_type: "all"}))
              - shapes.each do |shape|
                = link_to search_path(search_params.merge({transaction_type: shape[:name]})), class:  "toggle-menu-subitem" do
                  = t(shape[:name_tr_key])

        - if @show_categories
          .toggle-container.home-toolbar-toggle-container.hidden-tablet
            .toggle.with-borders{data: {toggle: '#home-toolbar-categories-menu'}}
              .toggle-header-container
                .toggle-header
                  - if selected_category
                    = @category_display_names[selected_category.id]
                  - else
                    = t("homepage.filters.all_categories")
                = icon_tag("dropdown", ["icon-dropdown"])
            #home-toolbar-categories-menu.toggle-menu
              = link_to t("homepage.filters.all_categories"), search_path(search_params.merge({category: "all"}))
              - @main_categories.each do |category|
                = link_to @category_display_names[category.id], search_path(search_params.merge({category: category}))
                - if category.children
                  - category.children.each do |child|
                    - is_selected = selected_category == child
                    = link_to @category_display_names[child.id], search_path(search_params.merge({category: child})), :class => "toggle-menu-subitem"

        / Filters
        .hidden-tablet
          #filters
            = render :partial => "filters", :locals => { show_price_filter: show_price_filter, show_custom_fields: @show_custom_fields, filters: filters }

  .row
    - if @category_menu_enabled
      .col-3.visible-tablet
        - if @show_categories
          .row
            .col-12
              = link_to t("homepage.filters.all_categories"), search_path(search_params.merge({category: "all"})), :class => "home-categories-main #{if selected_category.nil? then 'selected' end}"
              - @main_categories.each do |category|
                - show_subcategories = show_subcategory_list(category, Maybe(selected_category).id.to_i.or_else(nil))
                = link_to @category_display_names[category.id], search_path(search_params.merge({category: category})), :class => "home-categories-main #{if show_subcategories then 'selected' end} #{if category.has_subcategories? then 'has-subcategories' end}", :data => {category: category.id}
                - if category.children
                  - if show_subcategories
                    - category.children.each do |child|
                      - is_selected = selected_category == child
                      = link_to @category_display_names[child.id], search_path(search_params.merge({category: child})), :class => "home-categories-sub #{if is_selected then 'selected' end}", :data => {:"sub-category" =>child.id}

        #desktop-filters

    - main_container_class = if @category_menu_enabled then "col-9" else "col-12" end
    %div{:class => main_container_class}
      - if @listings.total_entries > 0
        - if @view_type.eql?("map")
          .home-map
            = render :partial => "map", locals: { viewport: viewport }
        - else
          - if @view_type.eql?("grid")
            %div{class: @category_menu_enabled ? "home-fluid-thumbnail-grid-narrow" : "home-fluid-thumbnail-grid-wide"}
              .home-fluid-thumbnail-grid
                = render partial: "grid_item", collection: @listings, as: :listing, locals: { show_distance: location_search_in_use }
          - else
            .home-listings
              - if (location_search_in_use)
                = render partial: "list_item_with_distance", collection: @listings, as: :listing, locals: { shape_name_map: shape_name_map, show_distance: location_search_in_use }
              - else
                = render partial: "list_item", collection: @listings, as: :listing, locals: { shape_name_map: shape_name_map }
          .home-loading-more
            = will_paginate(@listings)
            - item_container = if @view_type.eql?("grid") then '.home-fluid-thumbnail-grid' else '.home-listings' end
            = pageless(@listings.total_pages, item_container, current_search_path_without_page, t('.loading_more_content'), current_page)
      - else
        .home-no-listings
          - if params[:q] || params[:category] || params[:share_type]
            = t(".no_listings_with_your_search_criteria")
          - else
            = t(".no_listings_notification", add_listing_link: link_to(t(".add_listing_link_text"), new_listing_path(ref: "add_listing_link"))).html_safe
