- content_for :javascript do
  initialize_homepage();

- content_for :coverfade_class do
  = "without-text"

- content_for :extra_javascript do
  :javascript
    // 楽市楽間 — 注目のスキル横スクロールスライダー
    window.RakuFeatured = {
      scrollEl: function () { return document.getElementById('raku-featured-scroll'); },
      slide: function (dir) {
        var el = this.scrollEl();
        if (!el) return;
        var card = el.querySelector('.raku-featured__card');
        var step = card ? (card.offsetWidth + 16) : 296;
        el.scrollBy({ left: dir * step, behavior: 'smooth' });
      }
    };
    (function () {
      var el = window.RakuFeatured.scrollEl();
      if (!el) return;
      // ドラッグでスクロール
      var down = false, startX = 0, startScroll = 0;
      el.addEventListener('mousedown', function (e) {
        down = true; startX = e.pageX; startScroll = el.scrollLeft;
        el.classList.add('is-dragging');
      });
      window.addEventListener('mouseup', function () {
        down = false; el.classList.remove('is-dragging');
      });
      window.addEventListener('mousemove', function (e) {
        if (!down) return;
        e.preventDefault();
        el.scrollLeft = startScroll - (e.pageX - startX);
      });
    })();

-# ═══════════════════════════════════════════════════════════
-# ヒーロー/統計/カテゴリ（トップ用）— 一覧ページ(/browse)では非表示
- unless @listing_page
  = render "homepage/intro"
-# Featured Cards
-# ═══════════════════════════════════════════════════════════
.raku-featured
  .raku-featured__header
    %h2.raku-featured__title= t('lamprey.homepage.featured_title')
    .raku-featured__tabs
      %button.raku-featured__tab.is-active{type: "button", data: {sort: "popular"}}= t('lamprey.homepage.tab_popular')
      %button.raku-featured__tab{type: "button", data: {sort: "newest"}}= t('lamprey.homepage.tab_newest')
      %button.raku-featured__tab{type: "button", data: {sort: "rating"}}= t('lamprey.homepage.tab_rating')
  .raku-featured__slider
    %button.raku-featured__arrow.raku-featured__arrow--prev{type: "button", "aria-label": t('lamprey.homepage.slide_prev'), onclick: "RakuFeatured.slide(-1)"} ‹
    .raku-featured__scroll#raku-featured-scroll
      - @listings.each do |listing|
        = link_to listing_path(listing.url), class: "raku-featured__card" do
          .raku-card
            - if listing.listing_images.first
              %img.raku-card__image{src: listing.listing_images.first[:small_3x2] || listing.listing_images.first[:thumb], alt: listing.title}
            - else
              .raku-card__image.raku-card__image--placeholder 🤖
            .raku-card__body
              %h3.raku-card__title= listing.title
              .raku-card__author
                - if listing.author
                  %span= listing.author.display_name || listing.author.username
                - else
                  %span= t('lamprey.homepage.card_author_unknown')
              %p.raku-card__description= StringUtils.first_words(listing.description, 60)
            .raku-card__footer
              .raku-card__rating
                %span.raku-muted-label= t('lamprey.listings.rating_none')
              .raku-card__price
                - if listing.price
                  = MoneyViewUtils.to_humanized(listing.price)
                - else
                  = t('lamprey.listings.free')
    %button.raku-featured__arrow.raku-featured__arrow--next{type: "button", "aria-label": t('lamprey.homepage.slide_next'), onclick: "RakuFeatured.slide(1)"} ›

    - if @listings.empty?
      .raku-featured__empty
        %p= t('lamprey.homepage.empty_title')
        %p= t('lamprey.homepage.empty_subtitle')

-# ═══════════════════════════════════════════════════════════
-# Original search / listing grid (preserved from Sharetribe)
-# ═══════════════════════════════════════════════════════════
- is_homepage = params[:controller] == "homepage" && params[:action] == "index"

- if @current_community.private? && @big_cover_photo
  - if @community_customization && @community_customization.private_community_homepage_content
    .community-customization-wrapper
      = @community_customization.private_community_homepage_content.html_safe
  - else
    = t(".this_is_private_community")
- else
  .home-toolbar
    - if listing_shape_menu_enabled || @category_menu_enabled
      .home-toolbar-show-filters-button-container
        .home-toolbar-show-filters-button#home-toolbar-show-filters
          = t(".filter")

    .home-toolbar-button-group{:class => listing_shape_menu_enabled || @category_menu_enabled ? "filters-enabled" : ""}
      - allowed_view_types.each do |view_type|
        - selected_class = @view_type == view_type ? "selected" : ""
        = link_to raku_listing_index_path(search_params.except(:action, :controller, :locale, :utf8).merge(view: view_type)), :class => "home-toolbar-button-group-button #{selected_class}", :title => t("homepage.filters.#{view_type}_button") do
          = icon_tag(view_type, ["icon-fix", "home-button-group-icon"])
          %span.home-toolbar-button-text
            = t("homepage.filters.#{view_type}_button")

    - if listing_shape_menu_enabled || @category_menu_enabled
      .home-toolbar-filters.home-toolbar-filters-mobile-hidden#home-toolbar-filters
        - if listing_shape_menu_enabled
          .toggle-container.home-toolbar-toggle-container
            .toggle.with-borders#home_toolbar-select-share-type{data: {toggle: '.home-toolbar-share-type-menu'}}
              .toggle-header-container
                .toggle-header
                  - if selected_shape
                    = t(selected_shape[:name_tr_key])
                  - else
                    = t("homepage.filters.all_listing_types")
                = icon_tag("dropdown", ["icon-dropdown"])
            .home-toolbar-share-type-menu.toggle-menu.hidden
              = link_to t("homepage.filters.all_listing_types"), raku_listing_index_path(search_params.except(:action, :controller, :locale, :utf8).merge({transaction_type: "all"}))
              - shapes.each do |shape|
                = link_to raku_listing_index_path(search_params.except(:action, :controller, :locale, :utf8).merge({transaction_type: shape[:name]})), class:  "toggle-menu-subitem" do
                  = t(shape[:name_tr_key])

        - if @show_categories
          .toggle-container.home-toolbar-toggle-container.hidden-tablet
            .toggle.with-borders{data: {toggle: '#home-toolbar-categories-menu'}}
              .toggle-header-container
                .toggle-header
                  - if selected_category
                    = @category_display_names[selected_category.id]
                  - else
                    = t("homepage.filters.all_categories")
                = icon_tag("dropdown", ["icon-dropdown"])
            #home-toolbar-categories-menu.toggle-menu
              = link_to t("homepage.filters.all_categories"), browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: "all"}))
              - @main_categories.each do |category|
                = link_to @category_display_names[category.id], browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: category}))
                - if category.children
                  - category.children.each do |child|
                    - is_selected = selected_category == child
                    = link_to @category_display_names[child.id], browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: child})), :class => "toggle-menu-subitem"

        / Filters
        .hidden-tablet
          #filters
            = render :partial => "filters", :locals => { show_price_filter: show_price_filter, show_custom_fields: @show_custom_fields, filters: filters }

  .row
    - if @category_menu_enabled
      .col-3.visible-tablet
        - if @show_categories
          .row
            .col-12
              = link_to t("homepage.filters.all_categories"), browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: "all"})), :class => "home-categories-main #{if selected_category.nil? then 'selected' end}"
              - @main_categories.each do |category|
                - show_subcategories = show_subcategory_list(category, Maybe(selected_category).id.to_i.or_else(nil))
                = link_to @category_display_names[category.id], browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: category})), :class => "home-categories-main #{if show_subcategories then 'selected' end} #{if category.has_subcategories? then 'has-subcategories' end}", :data => {category: category.id}
                - if category.children
                  - if show_subcategories
                    - category.children.each do |child|
                      - is_selected = selected_category == child
                      = link_to @category_display_names[child.id], browse_path(search_params.except(:view, :action, :controller, :locale, :utf8).merge({category: child})), :class => "home-categories-sub #{if is_selected then 'selected' end}", :data => {:"sub-category" =>child.id}

        #desktop-filters

    - main_container_class = if @category_menu_enabled then "col-9" else "col-12" end
    %div{:class => main_container_class}
      - if @listings.total_entries > 0
        - if @view_type.eql?("map")
          .home-map
            = render :partial => "map", locals: { viewport: viewport }
        - else
          - if @view_type.eql?("grid")
            %div{class: @category_menu_enabled ? "home-fluid-thumbnail-grid-narrow" : "home-fluid-thumbnail-grid-wide"}
              .home-fluid-thumbnail-grid
                = render partial: "grid_item", collection: @listings, as: :listing, locals: { show_distance: location_search_in_use }
          - else
            .home-listings
              - if (location_search_in_use)
                = render partial: "list_item_with_distance", collection: @listings, as: :listing, locals: { shape_name_map: shape_name_map, show_distance: location_search_in_use }
              - else
                = render partial: "list_item", collection: @listings, as: :listing, locals: { shape_name_map: shape_name_map }
          .home-loading-more
            = will_paginate(@listings)
            - item_container = if @view_type.eql?("grid") then '.home-fluid-thumbnail-grid' else '.home-listings' end
            = pageless(@listings.total_pages, item_container, current_search_path_without_page, t('.loading_more_content'), current_page)
      - else
        .home-no-listings
          - if params[:q] || params[:category] || params[:share_type]
            = t(".no_listings_with_your_search_criteria")
          - else
            = t(".no_listings_notification", add_listing_link: link_to(t(".add_listing_link_text"), new_listing_path(ref: "add_listing_link"))).html_safe
