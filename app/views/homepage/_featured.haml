-# Featured Cards
-# ═══════════════════════════════════════════════════════════
-# 並び順タブ（Issue #80 / #81）。
-# 以前は JS で DOM を並べ替えていたが、一覧グリッドはサーバーが描画するため
-# カードの並びが変わらなかった。タブをリンクにしてサーバー側で並べ替える
-# （注目カードと一覧グリッドの順序が常に一致する）。
- featured_sort = %w[newest rating].include?(params[:sort].to_s) ? params[:sort].to_s : "popular"
- featured_tab_href = ->(key) { "#{request.path}?#{request.query_parameters.except("page").merge("sort" => key).to_query}" }
.raku-featured
  .raku-featured__header
    %h2.raku-featured__title= t('lamprey.homepage.featured_title')
    .raku-featured__tabs
      - [["popular", t('lamprey.homepage.tab_popular')], ["newest", t('lamprey.homepage.tab_newest')], ["rating", t('lamprey.homepage.tab_rating')]].each do |key, label|
        %a.raku-featured__tab{class: (featured_sort == key ? "is-active" : nil), href: featured_tab_href.call(key), data: {sort: key}}= label
  .raku-featured__slider
    %button.raku-featured__arrow.raku-featured__arrow--prev{type: "button", "aria-label": t('lamprey.homepage.slide_prev'), onclick: "RakuFeatured.slide(-1)"} ‹
    .raku-featured__scroll#raku-featured-scroll
      - @listings.each do |listing|
        -# タブ並び替え（Issue #6）用のデータ属性。人気 = 初期の並び順。
        -# 評価は検索結果に含まれないため controller が補った値を弾く。
        - rating = (@featured_ratings || {}).fetch(listing.id, 0).to_f
        = link_to listing_path(listing.url), class: "raku-featured__card", data: {created_at: (listing.created_at.respond_to?(:to_i) ? listing.created_at.to_i : 0), avg_rating: rating} do
          .raku-card
            - if listing.listing_images.first
              %img.raku-card__image{src: listing.listing_images.first[:small_3x2] || listing.listing_images.first[:thumb], alt: ""}
            - else
              .raku-card__image.raku-card__image--placeholder 🤖
            .raku-card__body
              %h3.raku-card__title= listing.title
              .raku-card__author
                - if listing.author
                  %span= listing.author.display_name || listing.author.username
                - else
                  %span= t('lamprey.homepage.card_author_unknown')
              %p.raku-card__description= StringUtils.first_words(listing.description, 60)
            .raku-card__footer
              .raku-card__rating
                - if rating > 0
                  %span.raku-card__rating-value= "★ #{rating.round(1)}"
                - else
                  %span.raku-muted-label= t('lamprey.listings.rating_none')
              .raku-card__price
                -# Issue #52: 価格未設定の出品は非公開のため一覧に出ない。価格がある場合のみ表示する。
                -# 検索結果の `price` は Money で、`ListingItem` に `price_cents` は無い（Issue #52 で追加した判定が 500 の原因だった）。
                - if listing.price && listing.price.to_f.positive?
                  = MoneyViewUtils.to_humanized(listing.price)
    %button.raku-featured__arrow.raku-featured__arrow--next{type: "button", "aria-label": t('lamprey.homepage.slide_next'), onclick: "RakuFeatured.slide(1)"} ›

    - if @listings.empty?
      .raku-featured__empty
        %p= t('lamprey.homepage.empty_title')
        %p= t('lamprey.homepage.empty_subtitle')
