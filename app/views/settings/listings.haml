- content_for :title_header do
  %h1
    = t("layouts.settings.settings")
    = "-"
    = t("layouts.settings.listings")

%p.back-to-mypage= link_to "← #{t('lamprey.mypage.dashboard')}", person_path(username: @current_user.username)

.left-navi-section.settings-no-nav
